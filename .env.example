# Independent Payload instance; DATABASE_URL uses the restricted spitzli schema role.
OPERATOR_EMAIL="dominik@spitzli.dev"
ADMIN_PASSWORD=""
BLOB_READ_WRITE_TOKEN=""
CONTACT_ENABLED="false"
DATABASE_URL="postgresql://spitzli:CHANGE_ME@127.0.0.1:55439/spitzli"
DATABASE_URL_UNPOOLED=""
DB_PASSWORD="CHANGE_ME"
HCAPTCHA_SECRET=""
HCAPTCHA_SITE_KEY="fdee7cec-1caa-4bb4-b7b0-b526ecfe1f02"
PAYLOAD_SECRET=""
SITE_URL="http://localhost:3000"
# Optional CMS origin when different from the canonical public website.
NEXT_PUBLIC_SERVER_URL=""
SMTP_FROM="info@spitzli.dev"
SMTP_HOST="pro.eu.turbo-smtp.com"
SMTP_PASSWORD=""
SMTP_PORT="465"
SMTP_USER=""

# Optional Webdock SSO; set all values together. Local password login remains available.
WEBDOCK_AUTH_ISSUER=https://auth.webdock.dev/api/auth
WEBDOCK_SSO_CLIENT_ID=
WEBDOCK_SSO_CLIENT_SECRET=
WEBDOCK_SSO_COOKIE_SECRET=
WEBDOCK_SSO_APP_ORIGIN=https://spitzli.dev
WEBDOCK_SSO_ALLOW_LOCAL_HTTP=false

# Temporary legacy rollout: false still permits local passwords/JWTs outside central policy.
# Set true after operator MFA enrollment and customer migration to disable local login/recovery/JWTs.
WEBDOCK_SSO_ENFORCE=false
