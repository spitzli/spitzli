# Copy to .env.local. Never commit credentials. Use a separate DB/Blob store for previews.
SITE_URL=http://localhost:3000
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://spitzli:CHANGE_ME@127.0.0.1:55439/spitzli
PAYLOAD_SECRET=
# Public Blob store on Vercel. Only rights-cleared public images may be uploaded.
BLOB_READ_WRITE_TOKEN=

# turboSMTP: use the host and verified sender shown in your account.
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dominik@spitzli.dev
CONTACT_EMAIL=dominik@spitzli.dev
# Keep disabled until the legal notice/privacy information and delivery are verified.
CONTACT_ENABLED=false

# Mandatory before a production deployment. These values are rendered publicly.
LEGAL_STREET=
LEGAL_POSTCODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_BUSINESS_ID=
LEGAL_REGISTER=
# Confirm only after reviewing the actual hosting/mail/DB arrangements and legal texts.
LEGAL_REVIEWED=false
PRIVACY_REVIEWED=false
PRIVACY_DATABASE_PROVIDER=
PRIVACY_DATABASE_REGION=
PRIVACY_LOG_RETENTION=
PRIVACY_MAIL_PROVIDER=
PRIVACY_TRANSFERS=

# First admin: only needed locally for npm run cms:bootstrap; remove afterwards.
ADMIN_EMAIL=dominik@spitzli.dev
ADMIN_PASSWORD=
