{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!.next",
      "!!.vercel",
      "!!src/i18n/messages",
      "!!index.html",
      "!!assets",
      "!!public",
      "!!src/payload-types.ts",
      "!!src/migrations-instance",
      "!!src/app/(payload)/admin/importMap.js",
      "!!.backups"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": false
    }
  }
}
